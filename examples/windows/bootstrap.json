{
  "platforms": ["windows"],
  "setup": [
    {
      "name": "powershell",
      "run": [
        "winget", "install", "--id", "Microsoft.PowerShell", "--exact", "--source", "winget",
        "--accept-source-agreements", "--accept-package-agreements"
      ],
      "provides": "pwsh"
    },
    {
      "name": "profile",
      "run": ["pwsh", "-NoProfile", "-File", "setup/profile.ps1"],
      "creates": "{documents}/PowerShell/profile.ps1"
    }
  ]
}
